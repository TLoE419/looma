+#[cfg(test)]
+mod backport_tests {
+    #[test]
+    fn missing_template_returns_a_diagnostic() {
+        let input = syn::parse_quote!(
+            struct MissingTemplate;
+        );
+        let error = super::composite_template_derive::impl_composite_template(&input).unwrap_err();
+        assert!(error.to_string().contains("requires #[template"));
+    }
+
+    #[test]
+    fn non_struct_template_returns_a_diagnostic() {
+        let input = syn::parse_quote!(
+            #[template(string = "<interface/>")]
+            enum Invalid {
+                Value,
+            }
+        );
+        let error = super::composite_template_derive::impl_composite_template(&input).unwrap_err();
+        assert!(error.to_string().contains("only supports structs"));
+    }
+
+    #[test]
+    fn invalid_child_attribute_returns_a_diagnostic() {
+        let input = syn::parse_quote!(
+            #[template(string = "<interface/>")]
+            struct Invalid {
+                #[template_child(unknown = "x")]
+                child: (),
+            }
+        );
+        assert!(super::composite_template_derive::impl_composite_template(&input).is_err());
+    }
+
+    #[test]
+    fn valid_template_still_generates_code() {
+        let input = syn::parse_quote!(
+            #[template(string = "<interface/>")]
+            struct Valid {}
+        );
+        assert!(super::composite_template_derive::impl_composite_template(&input).is_ok());
+    }
+}
